# Direct Cloudflare deployment authentication. The publishable key is designed
# for browser use; SUPABASE_SECRET_KEY must only be stored as a Cloudflare secret.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_GOOGLE_ENABLED=false

# Optional FashionSigLIP-compatible garment analysis service.
FASHION_SIGLIP_URL=https://your-fashion-siglip-service.example/analyze
FASHION_SIGLIP_TOKEN=

# Optional garment label OCR + barcode resolver.
OCR_BARCODE_URL=https://your-ocr-barcode-adapter.example/resolve
OCR_BARCODE_TOKEN=

# Optional official/e-commerce product metadata importer.
PRODUCT_IMPORT_URL=https://your-product-import-adapter.example/import
PRODUCT_IMPORT_TOKEN=

# Optional photo-to-body reconstruction service.
SAM3D_BODY_URL=https://your-sam3d-body-adapter.example/reconstruct
SAM3D_BODY_TOKEN=

# Optional measurements-to-body MHR service.
MHR_URL=https://your-mhr-adapter.example/build-body
MHR_TOKEN=

# Optional body-aware 3D garment fitting / cloth simulation service. It should
# return a combined GLB meshUrl; the browser WebGL preview is used when absent.
GARMENT_3D_URL=https://your-3d-garment-adapter.example/simulate
GARMENT_3D_TOKEN=

# Optional service that segments several garments from one uploaded photo.
BATCH_SEGMENT_URL=https://your-batch-segmentation-adapter.example/segment
BATCH_SEGMENT_TOKEN=

# Optional mirror-selfie vision analysis for diary learning signals.
OUTFIT_DIARY_VISION_URL=https://your-outfit-diary-vision-adapter.example/analyze
OUTFIT_DIARY_VISION_TOKEN=

# Optional AI style-twin service. It can rerank curated trend references against
# the user's wardrobe, preference profile and latest body model.
STYLE_TWIN_URL=https://your-style-twin-adapter.example/recommend
STYLE_TWIN_TOKEN=

# Production safety limits. Values are enforced server-side per signed-in user.
MAX_REQUEST_BYTES=26214400
MAX_IMAGE_BYTES=8388608
DAILY_UPLOAD_COUNT=40
DAILY_UPLOAD_BYTES=104857600
DAILY_MODEL_CALLS=20
DAILY_MODEL_BUDGET_MICROS=300000
GLOBAL_DAILY_MODEL_CALLS=250
GLOBAL_DAILY_MODEL_BUDGET_MICROS=5000000
